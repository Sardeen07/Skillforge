{
  "name": "skillforge-forge",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node forge/py.mjs -m unittest discover tests -v",
    "retrieval": "node forge/py.mjs forge/score_retrieval.py",
    "compose:demo": "node forge/py.mjs plugin/skills/skillforge/scripts/compose.py --subtask \"workers block each other in the job queue\"",
    "catalog:demo": "node forge/py.mjs plugin/skills/skillforge/scripts/compose.py --catalog",
    "ab": "node forge/py.mjs forge/ab.py",
    "graders": "node forge/py.mjs forge/validate_graders.py",
    "scan": "node forge/py.mjs forge/scan.py scan",
    "validate:library": "node forge/py.mjs forge/validate_library.py",
    "retrieval:suite": "node forge/py.mjs forge/score_retrieval.py --suite --budget 2400",
    "retrieval:heldout": "node forge/py.mjs forge/score_retrieval.py --heldout --budget 2400",
    "sweep": "node forge/py.mjs forge/sweep_retrieval.py",
    "cost": "node forge/py.mjs forge/context_cost.py"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsx": "^4.0.0"
  }
}
