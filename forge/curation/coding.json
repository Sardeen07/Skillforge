    {
      "name": "react-performance",
      "source": {
        "repo": "vercel-labs/agent-skills",
        "commit": "063bee94c3f4df8453406c830b0a7df0f2860278",
        "path": "skills/react-best-practices",
        "license": "MIT"
      },
      "exclude": [
        "*.zip"
      ],
      "capability": "React and Next.js performance",
      "overlap_group": "react-perf",
      "applies": [
        "react",
        "nextjs",
        "next",
        "component",
        "render",
        "rerender",
        "hook",
        "jsx",
        "tsx",
        "bundle",
        "hydration",
        "suspense",
        "memo"
      ],
      "technologies": [
        "react",
        "nextjs"
      ],
      "status": "provisional",
      "rules": {
        "rerender-memo": {
          "keywords": "every child redraws whenever parent updates state; child rerenders parent state updates unnecessary rerender memoize props"
        },
        "bundle-barrel-imports": {
          "keywords": "importing one helper from ui package pulls entire library bundle tree shaking barrel index side effects"
        },
        "async-parallel": {
          "keywords": "waits for one fetch request to finish before starting next sequential waterfall independent parallel"
        },
        "server-parallel-fetching": {
          "keywords": "server fetches requests sequentially await waterfall independent Promise.all parallel"
        },
        "js-hoist-regexp": {
          "keywords": "rebuild same pattern regular expression object for every row process compile once outside loop"
        },
        "js-index-maps": {
          "keywords": "find matching record inside loop thousands rows repeated lookup map index constant time"
        }
      }
    },
    {
      "name": "postgres",
      "source": {
        "repo": "supabase/agent-skills",
        "commit": "8331f910845103c08d51f6ca1d86ebb7d1f745e3",
        "path": "skills/supabase-postgres-best-practices",
        "license": "MIT"
      },
      "capability": "Postgres schema, queries, indexes, RLS",
      "overlap_group": "postgres",
      "applies": [
        "postgres",
        "postgresql",
        "sql",
        "query",
        "database",
        "db",
        "schema",
        "index",
        "migration",
        "table",
        "rls",
        "supabase",
        "pg",
        "explain"
      ],
      "technologies": [
        "postgres"
      ],
      "status": "provisional",
      "rules": {
        "data-pagination": {
          "keywords": "paging through results gets slower deeper page deep pages page 2 page 900 large offset pagination"
        },
        "query-missing-indexes": {
          "keywords": "filter status and created date together is slow planner not using index query plan explain analyze"
        },
        "schema-foreign-key-indexes": {
          "keywords": "deleting customer scans entire orders table foreign key customer_id index delete cascade"
        },
        "monitor-explain-analyze": {
          "keywords": "check whether planner uses index added statements eating most time query plan explain analyze"
        },
        "monitor-pg-stat-statements": {
          "keywords": "which statements consume time query frequency total execution time pg_stat_statements"
        },
        "data-n-plus-one": {
          "keywords": "fetch author separately for each post repeated query per row N plus one"
        },
        "security-rls-performance": {
          "keywords": "row security policy made every read crawl slow rls policy query performance"
        },
        "lock-skip-locked": {
          "keywords": "workers wait on each other queue throughput worker claim locked rows skip locked"
        }
      }
    },
