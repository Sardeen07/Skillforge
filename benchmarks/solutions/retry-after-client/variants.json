        "backs-off-without-header"
      ],
      "why": "parses Retry-After as an integer only; the HTTP-date form falls back to short backoff",
      "replace": {
        "client.py": [
          [
            "    try:\n        return max(0.0, parsedate_to_datetime(value).timestamp() - time.time())\n    except (TypeError, ValueError, IndexError, OverflowError):\n        return None",
