    {
      "name": "no-recheck",
      "must_fail": [
        "single-flight"
      ],
      "must_pass": [
        "returns-values",
        "keys-independent"
      ],
      "why": "per-key lock but computes again after acquiring it",
      "replace": {
        "cache.py": [
          [
            "        if key not in _values:\n            _values[key] = compute()",
            "        _values[key] = compute()"
          ]
        ]
      }
    }
